# Copy this file to .env and fill in only what you need — every one of
# these has a safe default (shown below) if left unset. `.env` itself is
# gitignored; never commit real values. docker-compose.yml reads this
# file automatically via `env_file: .env` for the backend service.
#
# See PROJECT_STATE.md's "Important environment variables" table for the
# full, authoritative list (this file covers the ones most relevant to
# running the app locally/in Docker) and docs/ci-cd.md for how the same
# variables map to GitHub Actions secrets for the live evaluation workflow.

# --- Core ---
# AQG_ENVIRONMENT=development
# AQG_LOG_LEVEL=INFO

# --- CORS (Sprint 11 note: required for the dashboard to reach the API
# cross-origin — see docker-compose.yml, which sets this automatically
# for the bundled frontend service) ---
# AQG_CORS_ORIGINS=http://localhost:5174

# --- Live providers (all opt-in; the deterministic provider needs none
# of these and is what CI/tests use by default) ---
# AQG_OPENAI_API_KEY=
# AQG_OPENAI_MODEL=gpt-4o-mini
# AQG_GEMINI_API_KEY=
# AQG_GEMINI_MODEL=gemini-2.5-flash

# --- RAGAS / DeepEval / OpenAI-Evals-concept evaluators (all opt-in,
# disabled by default; all reuse AQG_OPENAI_API_KEY above rather than a
# separate credential) ---
# AQG_RAGAS_ENABLED=false
# AQG_DEEPEVAL_ENABLED=false
# AQG_OPENAI_EVALS_ENABLED=false

# --- Phoenix tracing (opt-in; see docs/debugging-failed-runs.md) ---
# AQG_TRACING_ENABLED=false
# AQG_PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# --- Persistence (":memory:" by default — nothing persists across a
# restart unless you set a real path; docker-compose.yml sets one for you
# via a named volume) ---
# AQG_POLICY_DB_PATH=:memory:

# --- Frontend (Docker only — see frontend/docker-entrypoint.sh; local
# `npm run dev` uses VITE_API_BASE_URL in frontend/.env.local instead) ---
# API_BASE_URL=http://localhost:8000/api/v1
